# ─── ShiftSync AI — Backend Environment Variables ─────────────────────────────
# Copy this to .env and fill in your values before running locally.

# Google Cloud Project
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Gemini API Key — get from https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...

# Application credentials (for local development)
# On Cloud Run, uses the service account automatically
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# App settings
DEBUG=false
APP_NAME=ShiftSync AI

# CORS — set to your frontend Cloud Run URL in production
CORS_ORIGINS=["http://localhost:3000","https://your-frontend.run.app"]

# JWT — CHANGE THIS IN PRODUCTION
SECRET_KEY=change-me-in-production-use-long-random-string
