# ─── ShiftSync AI — Backend Environment Variables ─────────────────────────────
# Copy to .env and fill in your values before running the backend.

# Google Cloud
GOOGLE_CLOUD_PROJECT=shiftsync-manufacturing
# Use "shiftsync-local" for in-memory mode (no Firestore needed)
# GOOGLE_CLOUD_PROJECT=shiftsync-local

# Gemini API key — get one from https://aistudio.google.com/
GEMINI_API_KEY=PASTE_YOUR_AISTUDIO_KEY_HERE

# Optional: path to a GCP service account JSON key (for Firestore)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# App
APP_NAME=ShiftSync AI
APP_VERSION=1.0.0
DEBUG=true
CORS_ORIGINS=["*"]

# Firestore
FIRESTORE_DATABASE=(default)

# JWT (demo auth)
SECRET_KEY=shiftsync-secret-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
